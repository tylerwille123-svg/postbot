# Required
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_OWNER_ID=         # your numeric Telegram user ID (the bot tells you on /start if this is empty)
ANTHROPIC_API_KEY=         # https://console.anthropic.com
ZERNIO_API_KEY=            # https://zernio.com -> Settings -> API keys

# Optional
ZERNIO_PROFILE_ID=         # only post to accounts in this Zernio profile (default: every connected account)
OPENAI_API_KEY=            # enables voice notes (Whisper transcription)
MODEL=claude-sonnet-5-5
EFFORT=medium              # low | medium | high
TIMEZONE=America/New_York  # IANA zone used for "post Friday at 9am"
DATA_DIR=./data            # SQLite database + your BRAND.md live here; mount a volume in production
YOUTUBE_VISIBILITY=public  # public | unlisted | private
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
TIKTOK_COMMERCIAL_CONTENT=none  # none | brand_organic | brand_content
