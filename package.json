{
  "name": "postbot",
  "version": "0.1.0",
  "description": "Talk to a Telegram bot, it writes your social posts with Claude and publishes them through Zernio.",
  "license": "MIT",
  "author": "Wompel (https://wompelproducts.ai)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "telegram",
    "bot",
    "social-media",
    "claude",
    "anthropic",
    "zernio",
    "agent"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylerwille123-svg/postbot.git"
  },
  "homepage": "https://github.com/tylerwille123-svg/postbot"
}
